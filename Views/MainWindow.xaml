<Window x:Class="SpamBot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewmodels="clr-namespace:SpamBot.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="SpamBot"
        Width="420"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ResizeMode="CanMinimize"
        SizeToContent="Height"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16">

        <!-- Message TextBox -->
        <ui:TextBox ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Chat24}"
                    PlaceholderText="Message To Send"
                    Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Speed Slider -->
        <Grid Margin="0,20,0,0">
            <ui:TextBlock HorizontalAlignment="Left"
                          Text="Speed" />
            <ui:TextBlock HorizontalAlignment="Right"
                          Appearance="Secondary"
                          Text="{Binding SpeedLabel}" />
        </Grid>
        <Slider IsSnapToTickEnabled="True"
                LargeChange="10"
                Maximum="100"
                Minimum="1"
                SmallChange="1"
                TickFrequency="1"
                Value="{Binding MessagesPerSecond}" />
        <Grid>
            <ui:TextBlock HorizontalAlignment="Left"
                          Appearance="Tertiary"
                          FontTypography="Caption"
                          Text="Slower" />
            <ui:TextBlock HorizontalAlignment="Right"
                          Appearance="Tertiary"
                          FontTypography="Caption"
                          Text="Faster" />
        </Grid>

        <!-- Duration Slider -->
        <Grid Margin="0,20,0,0">
            <ui:TextBlock HorizontalAlignment="Left"
                          Text="Duration" />
            <ui:TextBlock HorizontalAlignment="Right"
                          Appearance="Secondary"
                          Text="{Binding DurationLabel}" />
        </Grid>
        <Slider IsSnapToTickEnabled="True"
                LargeChange="5"
                Maximum="60"
                Minimum="1"
                SmallChange="1"
                TickFrequency="1"
                Value="{Binding DurationSeconds}" />
        <ui:TextBlock Appearance="Tertiary"
                      FontTypography="Caption"
                      Text="{Binding EstimatedCountLabel}" />

        <!-- Action Buttons -->
        <primitives:UniformGrid Margin="0,20,0,0"
                                Columns="3"
                                Rows="1">
            <ui:Button Margin="0,0,4,0"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary"
                       Command="{Binding StartCommand}"
                       Content="Start"
                       Icon="{ui:SymbolIcon Play24}" />
            <ui:Button Margin="4,0"
                       HorizontalAlignment="Stretch"
                       Command="{Binding StartCancelCommand}"
                       Content="Stop"
                       Icon="{ui:SymbolIcon Stop24}" />
            <ui:Button Margin="4,0,0,0"
                       HorizontalAlignment="Stretch"
                       Command="{Binding ResetCommand}"
                       Content="Reset"
                       Icon="{ui:SymbolIcon ArrowCounterclockwise24}" />
        </primitives:UniformGrid>

        <!-- Status ProgressBar -->
        <ProgressBar Height="4"
                     Margin="0,20,0,8"
                     Maximum="100"
                     Value="{Binding ProgressPercentage}" />
        <ui:TextBlock HorizontalAlignment="Center"
                      Appearance="Secondary"
                      FontTypography="Caption"
                      Text="{Binding Status}" />

    </StackPanel>
</Window>
